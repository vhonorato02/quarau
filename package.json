{
  "name": "quarau",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@quarau/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @quarau/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:local": "node tools/db/local-pg.mjs",
    "seed": "pnpm --filter @quarau/web seed",
    "check:texts": "node tools/qa/hardcoded.mjs"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "embedded-postgres": "17.10.0-beta.17",
    "lighthouse": "^13.5.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "^0.7.0",
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  }
}
