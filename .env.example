# ---- Copy to .env for local development (never commit .env) ----
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLED_LOCALES=pt
SITE_NOINDEX=true

DATABASE_URL=postgres://quarau:quarau@localhost:5432/quarau
PAYLOAD_SECRET=change-me-to-a-long-random-string
PREVIEW_SECRET=change-me-preview-secret
REVALIDATE_SECRET=change-me-revalidate-secret

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=quarau-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=quarau
S3_SECRET_ACCESS_KEY=quarau-dev-secret

MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev-meili-master-key

REDIS_URL=redis://localhost:6379

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM_ADDRESS=nao-responda@quarau.com.br
EMAIL_FROM_NAME=Quarau
CONTACT_RECIPIENT=contato@quarau.com.br

# Cloudflare Turnstile (optional locally; test keys always pass)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Observability (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
