# Copy to apps/web/.env.local for development (never commit it). Every variable is documented in
# docs/ARCHITECTURE.md §Variáveis. Blank optional services are simply turned off.

# ---- site ----
SITE_URL=http://localhost:3000
# true everywhere except the real production domain: noindex + robots disallow.
SITE_NOINDEX=true

# ---- database (pnpm db:local starts this one without Docker) ----
DATABASE_URL=postgres://quarau:quarau@localhost:54329/quarau
PAYLOAD_DB_PUSH=false
# 32+ random characters: openssl rand -hex 32
PAYLOAD_SECRET=
REVALIDATE_SECRET=
# Bearer token for /api/payload-jobs/run (scheduled publishing).
CRON_SECRET=

# ---- media: S3-compatible bucket (Cloudflare R2). Leave blank to use the local disk (MEDIA_DIR). ----
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL of the bucket (R2 public bucket or custom domain), e.g. https://media.quarau.com.br
S3_PUBLIC_URL=
MEDIA_DIR=

# ---- e-mail: Resend (RESEND_API_KEY) or any SMTP server. Blank = messages only stored in the CMS. ----
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=nao-responda@quarau.com.br
EMAIL_FROM_NAME=Quarau
CONTACT_RECIPIENT=contato@quarau.com.br

# ---- anti-spam: Cloudflare Turnstile (blank = off). Test keys always pass. ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- audience measurement, only after consent: vercel | umami | blank (off) ----
NEXT_PUBLIC_ANALYTICS=
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ---- errors (blank = off) ----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
