{
  "name": "@quarau/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:vercel": "PAYLOAD_DB_PUSH=false NODE_OPTIONS=--max-old-space-size=6144 tsx scripts/vercel-build.ts",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen > /dev/null && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run -c vitest.int.config.ts",
    "test:e2e": "playwright test",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "seed:admin": "tsx --env-file-if-exists=.env.local scripts/create-admin.ts",
    "social:parse": "tsx scripts/social/parse-exports.ts",
    "scrape:wp": "tsx scripts/scrape/scrape-wp.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/email-nodemailer": "3.90.2",
    "@payloadcms/live-preview-react": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/plugin-redirects": "3.90.2",
    "@payloadcms/plugin-seo": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-s3": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "@quarau/emails": "workspace:*",
    "@quarau/ui": "workspace:*",
    "@sentry/nextjs": "11.4.0",
    "graphql": "^16.11.0",
    "next": "16.4.3",
    "nodemailer": "^10.0.15",
    "payload": "3.90.2",
    "pino": "10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "1.63.0",
    "@quarau/config": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "10.12.0",
    "postcss": "^8.5.6",
    "sass": "^1.93.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "5.0.3"
  }
}
